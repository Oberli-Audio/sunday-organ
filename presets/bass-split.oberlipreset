      <PARAM id="upperBar4" value="0"/>
      <PARAM id="upperBar5" value="0"/>
      <PARAM id="upperBar6" value="0"/>
      <PARAM id="upperBar7" value="0"/>
      <PARAM id="upperBar8" value="0"/>
